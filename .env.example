# Environment Variables for TwilightGame
# Copy this file to .env.local and modify as needed

# ============================================
# Firebase Configuration (Cloud Saves)
# ============================================
# Get these values from Firebase Console:
# 1. Go to https://console.firebase.google.com
# 2. Select your project (twiightgame)
# 3. Click the gear icon > Project settings
# 4. Scroll to "Your apps" > Web app
# 5. Copy the config values

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=twiightgame.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=twiightgame
VITE_FIREBASE_STORAGE_BUCKET=twiightgame.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id-here

# ============================================
# Firebase Enable/Disable
# ============================================
# Set to "false" to completely disable Firebase (cloud saves, shared data)
# Useful for local development without Firebase or GitHub Pages deployment
# Default: enabled if Firebase config is present
# VITE_FIREBASE_ENABLED=false

# ============================================
# Firebase Emulators (Development Only)
# ============================================
# Set to "true" to use local Firebase emulators
# Requires: firebase emulators:start
# VITE_USE_FIREBASE_EMULATORS=true

# ============================================
# Error Reporting (Sentry)
# ============================================
# Remote error/crash reporting — without this, an error only exists in that
# one player's browser console. Free tier: https://sentry.io
# 1. Sign up, create a new project, pick "React" as the platform
# 2. Copy the DSN it gives you (looks like https://xxx@oXXX.ingest.sentry.io/XXX)
# Leave unset to disable entirely — everything in utils/errorReporting.ts
# becomes a safe no-op, same as Firebase being unconfigured.

# VITE_SENTRY_DSN=your-dsn-here

# ============================================
# Game Testing
# ============================================
# Testing mode for farming system
# When true: Crops grow in real minutes (for fast testing)
# When false: Crops grow based on in-game time (production behavior)
# Default: true in development (npm run dev), false in production (npm run build)
# VITE_TESTING_MODE=true
